node_modules/
dist/
.tmp/

# The Node server bundle. It lives outside dist/ on purpose: dist/ is what the
# Cloudflare Worker publishes as static assets, so a server bundle in there would
# be served to the public alongside the client.
build/

# Wrangler and Miniflare state
.wrangler/

# Secrets: never commit a key
.env
.env.*
!.env.example

# Scratch output from scripts/generate_gps_slides.cjs
generated_pdf_b64.txt

# Local noise
.DS_Store
*.log

# Everything written for an assistant rather than for the project: the running
# notes in ai/NOTES.md, the standing instructions in ai/README.md, and whatever
# throwaway probes a session leaves behind. None of it is reviewed, none of it
# should be, and it carries absolute paths and dates from whichever machine it was
# written on.
#
# What belongs in the repository instead: anything true about the project rather
# than about the work of changing it. Put that in a comment beside the code, or in
# README.md if a user needs it.
ai/
