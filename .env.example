# Copy to .env for local development. Never commit a real key.

# Optional. When set, the server can call Gemini without the user pasting a key.
# Leave empty to require every user to bring their own key (the default).
GEMINI_API_KEY=

# Force users to bring their own key even when GEMINI_API_KEY is set.
# Defaults to true whenever GEMINI_API_KEY is empty.
REQUIRE_USER_API_KEY=true

# Server
PORT=3000

# Largest slide deck accepted, in megabytes (the JSON body limit is this + 6).
MAX_UPLOAD_MB=32

# Upstream timeouts in milliseconds.
REQUEST_TIMEOUT_MS=240000
CHAT_TIMEOUT_MS=90000

# Simple per-IP abuse guard.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40

# Model discovery gets its own, much tighter allowance. POST /api/models takes any
# key and answers either with a catalogue or a 401, which on a public deployment is
# a free "is this Gemini key valid?" service. Someone adding their own key needs one
# of these; someone working through a list of scraped keys needs thousands.
RATE_LIMIT_MODELS_MAX=8
# How many reverse proxies stand in front of this server. Leave empty when running
# it directly, as in development. The rate limit above keys on the caller's address,
# and behind a proxy that address is the proxy's unless this is set, which would put
# every visitor in the same bucket. Most hosting platforms terminate TLS in front of
# you and need TRUST_PROXY=1.
TRUST_PROXY=
